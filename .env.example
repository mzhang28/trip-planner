# Copy to .env for `docker compose up`. Every value here has a working default,
# except PUBLIC_URL once the app is reachable at anything but localhost.

# Where the browser reaches the app. Access tokens issued to MCP clients are
# bound to this origin, and calendar subscription URLs are handed out under it,
# so it has to match the URL people actually open.
PUBLIC_URL=http://localhost:8787

# The published port. PUBLIC_URL has to agree with it.
APP_PORT=8787

# Attachments go to a volume by default. For object storage instead:
# BLOB_STORE=s3
# S3_BUCKET=trip-planner
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PREFIX=blobs
# Point at R2, MinIO or B2; leave unset for AWS.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
